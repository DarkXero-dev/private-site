---
// CV — synced from Stefan-Chaanine-Resume-ATS.pdf, styled to match the site
const summary = 'IT and technical support specialist with 15+ years across Apple systems, enterprise IT, and open-source infrastructure. Hands-on with macOS, Windows, Linux, iOS, and Android: hardware diagnostics, software troubleshooting, systems administration, and technical documentation. Sole maintainer of an international Linux distribution since 2020, running release management, packaging, and infrastructure end to end. Multilingual (English C2, French C1, Arabic native). EU citizen based in Thessaloniki, targeting IT support, technical support, or systems administration roles.';

const jobs = [
  {
    company: 'XeroLinux (Open Source)',
    location: 'Remote',
    period: '2020 – Present',
    role: 'Independent Technical Project Lead',
    description: 'Sole maintainer of an international Linux distribution.',
    tasks: [
      'Packaging, release management, and system-level troubleshooting for a global user base',
      'Community infrastructure (wiki, Discord) and full technical documentation',
    ],
  },
  {
    company: 'Apple EU HQ',
    location: 'Cork, Ireland',
    period: '2019 – 2020',
    role: 'Transcriber and AI/ML Data Specialist, French Siri Team',
    description: 'French-language Siri NLP quality assurance, Apple EU HQ.',
    tasks: [
      'Quality-assured French-language Siri NLP responses for accuracy and policy compliance',
      'Geo-tagging and cross-functional QA with machine learning engineering teams',
    ],
  },
  {
    company: 'iStyle Computers',
    location: 'Dubai and Beirut',
    period: '2015 – 2019',
    role: 'Sales Executive & Cashier, Apple Technical Support',
    description: 'High-volume Apple retail, up to $150K monthly turnover.',
    tasks: [
      'Sales Executive and Cashier handling POS, receipts, and store accounts',
      'Diagnosed and resolved hardware, software, and peripheral issues for Apple products',
      'Up to $150K monthly turnover during Back to School and Black Friday peaks',
    ],
  },
  {
    company: 'Unilog Lebanon',
    location: 'Beirut, Lebanon',
    period: '2010 – 2015',
    role: 'Junior IT Support Technician',
    description: 'On-site IT support for enterprise client Régie Lebanon.',
    tasks: [
      'On-site support and troubleshooting for enterprise client Régie Lebanon',
      'Maintained operational continuity across Windows and mixed-OS environments',
    ],
  },
  {
    company: 'Independent',
    location: 'Beirut, Lebanon',
    period: '2003 – 2009',
    role: 'Freelance IT Technician',
    description: 'PC and Mac repair and diagnostics for individual and SMB clients.',
    tasks: [
      'PC and Mac hardware repair, software diagnostics, and technical maintenance',
    ],
  },
];

const languages = [
  { name: 'English', level: 'C2 (Bilingual)', fluency: 100 },
  { name: 'French', level: 'C1', fluency: 80 },
  { name: 'Arabic', level: 'Mother tongue', fluency: 100 },
];

const skills = [
  'IT & Technical Support (Hardware/Software Diagnostics)',
  'Linux / macOS / Windows Administration',
  'Systems Diagnostics & Troubleshooting',
  'IT Ticketing & Case Management',
  'Remote & On-site Support',
  'iOS / Android',
  'Release Management & Technical Documentation',
];
---

<div class="max-w-4xl mx-auto space-y-8">
  <div class="flex items-center justify-between">
    <h2 class="font-[family-name:var(--font-heading)] text-lg text-[var(--color-accent)]">Curriculum Vitae</h2>
    <a href="/Stefan-Chaanine-Resume.pdf" download
       class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-[var(--color-accent)] border border-[var(--color-border-accent)] rounded-lg hover:bg-[var(--color-accent-dim)] transition-colors">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Download PDF
    </a>
  </div>

  <!-- Header -->
  <div class="info-card overflow-hidden">
    <div class="h-20 sm:h-24 bg-[radial-gradient(ellipse_at_top_left,var(--color-accent-dim),transparent_60%),radial-gradient(ellipse_at_bottom_right,var(--color-accent-dim),transparent_60%)] bg-[var(--color-bg-card)]"></div>
    <div class="px-5 sm:px-6 pb-5 sm:pb-6 -mt-12 sm:-mt-14">
      <div class="shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-4 border-[var(--color-bg-card)] shadow-lg shadow-black/40">
        <img src="/stefan-avatar.jpg" alt="Stefan Chaanine" class="w-full h-full object-cover" loading="lazy" />
      </div>
      <div class="min-w-0 mt-3">
        <h3 class="font-[family-name:var(--font-heading)] text-lg font-bold text-[var(--color-text-primary)]">
          Stefan Chaanine
        </h3>
        <p class="text-sm text-[var(--color-accent)] mt-0.5">IT & Technical Support Specialist &mdash; Apple Systems & Linux Administration</p>
      </div>
    <div class="flex flex-wrap gap-2 mt-4">
      <a href="mailto:steve.chaanine@gmail.com"
         class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs text-[var(--color-text-secondary)] border border-[var(--color-border)] rounded-full hover:border-[var(--color-border-accent)] hover:text-[var(--color-accent)] transition-colors">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        steve.chaanine@gmail.com
      </a>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs text-[var(--color-text-secondary)] border border-[var(--color-border)] rounded-full">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        +30 694 577 4145
      </span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs text-[var(--color-text-secondary)] border border-[var(--color-border)] rounded-full">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Thessaloniki, Greece
      </span>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs text-[var(--color-accent)] border border-[var(--color-border-accent)] bg-[var(--color-accent-dim)] rounded-full">
        EU Citizen (Greek passport)
      </span>
    </div>
    </div>
  </div>

  <!-- Summary -->
  <div class="info-card p-5 sm:p-6">
    <h3 class="flex items-center gap-2 font-[family-name:var(--font-heading)] text-sm text-[var(--color-accent)] uppercase tracking-widest mb-3">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
      Profile
    </h3>
    <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed text-justify">{summary}</p>
  </div>

  <!-- Experience -->
  <div class="space-y-4">
    <h3 class="flex items-center gap-2 font-[family-name:var(--font-heading)] text-sm text-[var(--color-accent)] uppercase tracking-widest">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"/><path stroke-linecap="round" d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
      Professional Experience
    </h3>

    <div class="relative space-y-6 before:content-[''] before:absolute before:left-[-9px] before:top-2 before:bottom-2 before:w-px before:bg-[var(--color-border)]">
      {jobs.map((job) => (
        <div class="relative">
          <span class="absolute -left-[18px] top-1 w-[18px] h-[18px] rounded-full bg-[var(--color-bg-tab-active)] border-2 border-[var(--color-accent)] flex items-center justify-center">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
          </span>
          <div class="info-card p-5 space-y-3 hover:border-[var(--color-border-accent)] transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
              <div>
                <h4 class="font-[family-name:var(--font-heading)] text-sm font-bold text-[var(--color-text-primary)]">
                  {job.company}
                </h4>
                <p class="text-xs text-[var(--color-text-muted)]">{job.location}</p>
              </div>
              <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-accent)] whitespace-nowrap px-2 py-0.5 border border-[var(--color-border-accent)] rounded-full">
                {job.period}
              </span>
            </div>
            <p class="text-sm font-medium text-[var(--color-text-primary)]">{job.role}</p>
            <p class="text-xs text-[var(--color-text-secondary)] truncate">{job.description}</p>
            <ul class="space-y-1.5">
              {job.tasks.map((task) => (
                <li class="flex items-center gap-2 text-xs text-[var(--color-text-secondary)] min-w-0">
                  <span class="dot shrink-0"></span>
                  <span class="truncate">{task}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Education -->
  <div class="space-y-3">
    <h3 class="flex items-center gap-2 font-[family-name:var(--font-heading)] text-sm text-[var(--color-accent)] uppercase tracking-widest">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l9 5-9 5-9-5 9-5z"/><path stroke-linecap="round" d="M7 11v4c0 1.5 2.5 3 5 3s5-1.5 5-3v-4"/></svg>
      Education
    </h3>
    <div class="info-card p-5">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
        <div>
          <h4 class="font-[family-name:var(--font-heading)] text-sm font-bold text-[var(--color-text-primary)]">
            Louis Massignon French High School
          </h4>
          <p class="text-xs text-[var(--color-text-muted)]">Abu Dhabi, United Arab Emirates</p>
        </div>
        <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-accent)]">1998</span>
      </div>
      <p class="text-xs text-[var(--color-text-secondary)] mt-2">Baccalaureate level</p>
    </div>
  </div>

  <!-- Languages -->
  <div class="space-y-3">
    <h3 class="flex items-center gap-2 font-[family-name:var(--font-heading)] text-sm text-[var(--color-accent)] uppercase tracking-widest">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M3 12h18M12 3c2.5 2.5 4 6 4 9s-1.5 6.5-4 9c-2.5-2.5-4-6-4-9s1.5-6.5 4-9z"/></svg>
      Languages
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {languages.map((lang) => (
        <div class="info-card p-4">
          <div class="flex items-baseline justify-between">
            <span class="text-sm font-medium text-[var(--color-text-primary)]">{lang.name}</span>
            <span class="text-xs text-[var(--color-text-muted)]">{lang.level}</span>
          </div>
          <div class="mt-2 h-1.5 rounded-full bg-[var(--color-border)] overflow-hidden">
            <div class="h-full rounded-full bg-[var(--color-accent)]" style={`width: ${lang.fluency}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Technical Skills -->
  <div class="space-y-3">
    <h3 class="flex items-center gap-2 font-[family-name:var(--font-heading)] text-sm text-[var(--color-accent)] uppercase tracking-widest">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.5 3.5a4 4 0 00-5.4 5.4L3 15v3h3l6.1-6.1a4 4 0 005.4-5.4l-2.6 2.6-2-2 2.6-2.6z"/></svg>
      Technical Skills
    </h3>
    <div class="info-card p-5">
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs text-[var(--color-text-secondary)] border border-[var(--color-border)] rounded-full hover:border-[var(--color-border-accent)] hover:text-[var(--color-accent)] transition-colors">
            <span class="dot"></span>
            {skill}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ATS PDF download -->
  <div class="flex justify-center pt-2">
    <a href="/Stefan-Chaanine-Resume-ATS.pdf" download
       class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-[var(--color-accent)] border border-[var(--color-border-accent)] rounded-lg hover:bg-[var(--color-accent-dim)] transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Download ATS Version
    </a>
  </div>
</div>
